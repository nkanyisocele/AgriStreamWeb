<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AgriStreamWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AgriStreamWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AgriStreamWeb</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 justify-content-between">
                        <!-- Main Left-Aligned Core Application Navigation Links -->
                        <div class="d-flex">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark font-weight-bold" asp-area="" asp-controller="Telemetry" asp-action="Dashboard">Sensor Dashboard</a>
                        </li>

                        <!-- Task C: Drone Upload Portal Trigger Button -->
                        <li class="nav-item ms-2">
                            <a class="btn btn-outline-primary btn-sm my-1" asp-area="" asp-controller="Drone" asp-action="Upload">
                                Drone Imagery Portal
                            </a>
                        </li>
                </div>

                <!-- Task A & B: Right-Aligned Portal Authentication Access Buttons -->
                <div class="d-flex align-items-center">
                    <li class="nav-item me-2">
                        <a class="btn btn-sm btn-success text-white px-3" asp-area="" asp-controller="Account" asp-action="Login">
                            Sign In
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-sm btn-secondary text-white px-3" asp-area="" asp-controller="Account" asp-action="Register">
                            Register Account
                        </a>
                    </li>
                </div>
                </ul>

                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AgriStreamWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
